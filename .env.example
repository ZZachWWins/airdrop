# Copy to .env for local dev, or set these in Netlify under
# Site configuration → Environment variables. Every one has a working default;
# nothing here is required to get a first deploy running.

# ── Backend (Netlify Functions) ────────────────────────────────────────────

# Xeris node the verification checks against.
XERIS_NODE_URL=https://rpc.xerisweb.com

# Network id recorded on every verification record.
XERIS_NETWORK_ID=xeris-testnet

# Timeout for node reads, in ms.
XERIS_NODE_TIMEOUT_MS=8000

# Prefix on generated invite codes. Changing this after launch invalidates
# codes already in the wild — set it once, before you go live.
INVITE_CODE_PREFIX=XRS

# Bearer token for GET /api/export, which returns the full unmasked registry.
# The endpoint returns 503 until this is set. Use a long random value.
# ADMIN_TOKEN=

# ── Frontend (baked in at build time) ──────────────────────────────────────

VITE_NETWORK_LABEL=Xeris Testnet
VITE_NETWORK_ID=xeris-testnet
VITE_TOKEN_SYMBOL=XRS
VITE_INVITE_CODE_PREFIX=XRS

# Deep link that reopens the current page inside the Xeris Web4 browser.
# `{url}` is replaced with the URL-encoded page address. Leave unset and the
# UI shows copy-the-link instructions instead of an "Open in Xeris" button.
# VITE_WALLET_DEEPLINK=xeris://browse?url={url}

# Store links shown to visitors without the app.
# VITE_APP_STORE_URL=
# VITE_PLAY_STORE_URL=
VITE_WALLET_SITE_URL=https://xerisweb.com

# Sibling dapps linked in the footer.
VITE_DEX_URL=https://dex.xerisweb.com
VITE_LAUNCHPAD_URL=https://launchpad.xerisweb.com
